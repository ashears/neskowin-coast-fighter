{
  "name": "neskowin-coast-fighter",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "server": "npm run build:server && node server.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "npm run build:server && node --test tests/*.test.mjs",
    "test:browser": "npm run build && npm run build:server && playwright test"
  },
  "dependencies": {
    "@ashears/2d-fighter-framework": "file:vendor/ashears-2d-fighter-framework-0.2.0.tgz",
    "@ashears/fighter-direct": "file:vendor/ashears-fighter-direct-0.2.0.tgz",
    "@ashears/fighter-relay": "file:vendor/ashears-fighter-relay-0.2.0.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
